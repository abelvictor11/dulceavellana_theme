{%- capture warning_icon -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Zm0 5v6m0 3v.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture leaf_icon -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4C11 4 5 8 5 15c0 3 2 5 5 5 7 0 10-7 10-16ZM5 20c2-5 6-8 11-11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{%- endcapture -%}
{%- capture flame_icon -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2c1 5-3 6-3 10 0 2 1 3 2 4-3 0-5-2-5-5-2 2-3 4-3 6 0 4 3 6 8 6s8-3 8-8c0-4-2-8-7-13Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- if item.contains_peanuts -%}<span class="MenuDietary__Item MenuDietary__Item--warning" title="Contiene maní">{{ warning_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Contiene maní</span></span>{%- endif -%}
{%- if item.contains_tree_nuts -%}<span class="MenuDietary__Item MenuDietary__Item--warning" title="Contiene frutos secos">{{ warning_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Contiene frutos secos</span></span>{%- endif -%}
{%- if item.contains_gluten -%}<span class="MenuDietary__Item MenuDietary__Item--warning" title="Contiene gluten">{{ warning_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Contiene gluten</span></span>{%- endif -%}
{%- if item.contains_dairy -%}<span class="MenuDietary__Item MenuDietary__Item--warning" title="Contiene lácteos">{{ warning_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Contiene lácteos</span></span>{%- endif -%}
{%- if item.is_spicy -%}<span class="MenuDietary__Item MenuDietary__Item--warning" title="Picante">{{ flame_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Picante</span></span>{%- endif -%}
{%- if item.is_vegetarian -%}<span class="MenuDietary__Item MenuDietary__Item--attribute" title="Vegetariano">{{ leaf_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Vegetariano</span></span>{%- endif -%}
{%- if item.is_vegan -%}<span class="MenuDietary__Item MenuDietary__Item--attribute" title="Vegano">{{ leaf_icon }}<span class="{% if compact %}visually-hidden{% endif %}">Vegano</span></span>{%- endif -%}
