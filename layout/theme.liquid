<!-- Meta Pixel: eventos custom con variant_id -->
<script>
(function () {
  'use strict';

  // ─── Utilidades ────────────────────────────────────────────────────────────

  // Espera a que fbq exista usando MutationObserver en script tags si tarda,
  // con timeout máximo de 5s para no bloquear indefinidamente.
  function waitForFbq(cb) {
    var attempts = 0;
    var maxAttempts = 25; // 25 x 200ms = 5s máximo
    function check() {
      if (typeof fbq !== 'undefined' && typeof fbq.callMethod === 'function') {
        cb();
      } else if (attempts < maxAttempts) {
        attempts++;
        setTimeout(check, 200);
      }
      // Si supera 5s, no ejecuta — evita callbacks huérfanos
    }
    check();
  }

  // ─── INTERCEPTOR: bloquea VC/ATC de Shopify con content_type=product_group ─
  function installFbqInterceptor() {
    if (window.__da_fbq_intercepted) return;
    window.__da_fbq_intercepted = true;

    var _original = window.fbq;
    var _wrapper = function () {
      try {
        if (
          arguments[0] === 'track' &&
          (arguments[1] === 'ViewContent' || arguments[1] === 'AddToCart') &&
          (arguments[2] || {}).content_type === 'product_group'
        ) {
          return; // bloquea duplicados de Shopify partner
        }
      } catch (e) { /* no-op */ }
      return _original.apply(this, arguments);
    };
    // Copia propiedades internas del Pixel (callMethod, queue, loaded, version)
    for (var k in _original) {
      if (Object.prototype.hasOwnProperty.call(_original, k)) {
        _wrapper[k] = _original[k];
      }
    }
    window.fbq = _wrapper;
  }

  // ─── INITIATE CHECKOUT: listener global en botones con data-fbq-initiate-checkout
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest
      ? e.target.closest('[data-fbq-initiate-checkout]')
      : null;
    if (!btn) return;
    if (typeof fbq === 'undefined') return;
    fbq('track', 'InitiateCheckout', {
      currency: 'COP',
      num_items: {{ cart.item_count }},
      value: {{ cart.total_price | divided_by: 100.0 }}
    });
  });

  // ─── PÁGINA DE PRODUCTO ─────────────────────────────────────────────────────
  {% if request.page_type == 'product' %}
  var VARIANTS = {
    {% for v in product.variants %}
    "{{ v.id }}": {
      price: {{ v.price | divided_by: 100.0 }},
      name: {{ product.title | append: ' - ' | append: v.title | json }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  function getCurrentVariantId() {
    var el = document.querySelector('[name="id"]');
    if (el && el.value) return String(el.value);
    var p = new URLSearchParams(location.search);
    if (p.get('variant')) return String(p.get('variant'));
    return "{{ product.selected_or_first_available_variant.id }}";
  }

  function trackViewContent(variantId) {
    var info = VARIANTS[variantId] || {
      price: {{ product.price | divided_by: 100.0 }},
      name: {{ product.title | json }}
    };
    fbq('track', 'ViewContent', {
      content_ids: [String(variantId), "{{ product.id }}"],
      content_type: 'product',
      content_name: info.name,
      value: parseFloat(info.price),
      currency: 'COP'
    });
  }

  function trackAddToCart(variantId, qty) {
    var q = qty || 1;
    var info = VARIANTS[variantId] || {
      price: {{ product.price | divided_by: 100.0 }},
      name: {{ product.title | json }}
    };
    fbq('track', 'AddToCart', {
      content_ids: [String(variantId), "{{ product.id }}"],
      content_type: 'product',
      content_name: info.name,
      value: parseFloat(info.price) * q,
      currency: 'COP',
      contents: [{ id: String(variantId), quantity: q, item_price: parseFloat(info.price) }],
      num_items: q
    });
  }

  var _vcFired = false;

  function initProductTracking() {
    installFbqInterceptor();

    // ViewContent inicial (solo una vez por carga)
    if (!_vcFired) {
      _vcFired = true;
      trackViewContent(getCurrentVariantId());
    }

    // VC al cambiar variante via evento nativo del tema
    document.addEventListener('variant:changed', function (e) {
      var variant = e.detail && e.detail.variant;
      if (variant) trackViewContent(String(variant.id));
    });

    // Fallback: VC al cambiar el select/input de variante
    document.addEventListener('change', function (e) {
      if (!e.target) return;
      if (
        e.target.name === 'id' ||
        (e.target.closest && e.target.closest('form[action^="/cart/add"]') && e.target.tagName === 'SELECT')
      ) {
        trackViewContent(getCurrentVariantId());
      }
    });

    // ATC via submit del formulario
    document.addEventListener('submit', function (e) {
      var form = e.target && e.target.closest
        ? e.target.closest('form[action^="/cart/add"]')
        : null;
      if (!form) return;
      var variantId = (form.querySelector('[name="id"]') || {}).value || getCurrentVariantId();
      var qtyEl = form.querySelector('[name="quantity"]');
      var qty = qtyEl ? (parseInt(qtyEl.value, 10) || 1) : 1;
      trackAddToCart(String(variantId), qty);
    });

    // ATC via evento del tema (AJAX cart)
    document.addEventListener('product:added', function (e) {
      var variant = e.detail && e.detail.variant;
      var qty = (e.detail && e.detail.quantity) || 1;
      if (variant) trackAddToCart(String(variant.id), qty);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { waitForFbq(initProductTracking); });
  } else {
    waitForFbq(initProductTracking);
  }
  {% endif %}

})();
</script>
<!-- /Meta Pixel eventos custom -->

