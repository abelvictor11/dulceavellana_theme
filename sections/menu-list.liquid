{%- comment -%}
  Carta informativa configurable desde el editor del tema.
  Los bloques de ítem pertenecen a la categoría que los precede.
{%- endcomment -%}

{%- assign uid = section.id -%}
{%- assign has_named_category = false -%}

<style>
  #Menu-{{ uid }} {
    --menu-accent: {{ section.settings.accent_color | default: settings.button_background }};
    --menu-accent-text: {{ section.settings.accent_text_color | default: settings.button_text_color }};
    --menu-card-radius: {{ section.settings.card_radius }}px;
    --menu-modal-radius: {{ section.settings.modal_radius }}px;
    --menu-image-size: {{ section.settings.image_size }}px;
    --menu-gap: 20px;
  }

  html.MenuModalOpen,
  html.MenuModalOpen body { overflow: hidden; }

  #Menu-{{ uid }} .MenuSection__Intro {
    margin-bottom: 32px;
    text-align: {{ section.settings.heading_alignment }};
  }
  #Menu-{{ uid }} .MenuSection__Title { margin-bottom: 0; }
  #Menu-{{ uid }} .MenuSection__Description {
    max-width: 680px;
    margin: 12px auto 0;
    color: var(--text-color-light);
  }
  #Menu-{{ uid }} .MenuSection__Intro--left .MenuSection__Description { margin-left: 0; }

  #Menu-{{ uid }} .MenuFilter {
    position: {% if section.settings.sticky_filter %}sticky{% else %}relative{% endif %};
    top: var(--header-base-height, 80px);
    z-index: 5;
    margin-bottom: 28px;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    background: rgba(var(--background-rgb), 0.94);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
  }
  #Menu-{{ uid }} .MenuFilter__Track {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 12px 0;
    scrollbar-width: none;
  }
  #Menu-{{ uid }} .MenuFilter__Track::-webkit-scrollbar { display: none; }
  #Menu-{{ uid }} .MenuFilter__Item {
    flex: 0 0 auto;
    padding: 9px 17px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: transparent;
    color: var(--text-color);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color .2s ease, background .2s ease, border-color .2s ease;
    white-space: nowrap;
  }
  #Menu-{{ uid }} .MenuFilter__Item:hover,
  #Menu-{{ uid }} .MenuFilter__Item.is-active {
    border-color: var(--menu-accent);
    background: var(--menu-accent);
    color: var(--menu-accent-text);
  }

  #Menu-{{ uid }} .MenuCategory {
    margin-bottom: 52px;
    scroll-margin-top: 150px;
  }
  #Menu-{{ uid }} .MenuCategory:not(:has(.MenuItem)) { display: none; }
  #Menu-{{ uid }} .MenuCategory__Header { margin-bottom: 20px; }
  #Menu-{{ uid }} .MenuCategory__Title { margin: 0; }
  #Menu-{{ uid }} .MenuCategory__Description {
    max-width: 680px;
    margin: 7px 0 0;
    color: var(--text-color-light);
  }
  #Menu-{{ uid }} .MenuGrid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.grid_columns }}, minmax(0, 1fr));
    gap: var(--menu-gap);
  }

  #Menu-{{ uid }} .MenuItem { min-width: 0; }
  #Menu-{{ uid }} .MenuItem__Button {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: calc(var(--menu-image-size) + 28px);
    gap: 16px;
    align-items: stretch;
    padding: 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--menu-card-radius);
    background: var(--light-background);
    color: var(--text-color);
    text-align: left;
    cursor: pointer;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  #Menu-{{ uid }} .MenuItem__Button:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--text-color-rgb), .22);
    box-shadow: 0 12px 30px rgba(var(--text-color-rgb), .08);
  }
  #Menu-{{ uid }} .MenuItem__Button:focus-visible,
  #Menu-{{ uid }} .MenuFilter__Item:focus-visible,
  #Menu-{{ uid }} .MenuDialog button:focus-visible {
    outline: 3px solid var(--menu-accent);
    outline-offset: 3px;
  }
  #Menu-{{ uid }} .MenuItem__Media {
    flex: 0 0 var(--menu-image-size);
    width: var(--menu-image-size);
    height: var(--menu-image-size);
    overflow: hidden;
    border-radius: max(0px, calc(var(--menu-card-radius) - 5px));
    background: rgba(var(--text-color-rgb), .055);
  }
  #Menu-{{ uid }} .MenuItem__Media img,
  #Menu-{{ uid }} .MenuDialog__MainImage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #Menu-{{ uid }} .MenuItem__Placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--text-color-light);
    font-family: var(--heading-font-family);
    font-size: 22px;
  }
  #Menu-{{ uid }} .MenuItem__Content {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    flex-direction: column;
  }
  #Menu-{{ uid }} .MenuItem__Badge,
  #Menu-{{ uid }} .MenuDialog__Badge {
    align-self: flex-start;
    margin-bottom: 7px;
    padding: 4px 9px;
    border-radius: 999px;
    background: rgba(var(--text-color-rgb), .07);
    color: var(--text-color-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .07em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  #Menu-{{ uid }} .MenuItem__Name {
    margin: 0;
    color: var(--heading-color);
    font-family: var(--heading-font-family);
    font-size: 17px;
    line-height: 1.3;
  }
  #Menu-{{ uid }} .MenuDietary { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }
  #Menu-{{ uid }} .MenuDietary__Item { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; }
  #Menu-{{ uid }} .MenuDietary__Item svg { width: 17px; height: 17px; flex: 0 0 17px; }
  #Menu-{{ uid }} .MenuDietary--card .MenuDietary__Item { padding: 4px; }
  #Menu-{{ uid }} .MenuDietary--modal .MenuDietary__Item { padding: 6px 10px; font-size: 12px; font-weight: 600; }
  #Menu-{{ uid }} .MenuDietary__Item--warning { background: #fff3e7; color: #8a4718; }
  #Menu-{{ uid }} .MenuDietary__Item--attribute { background: #edf7ee; color: #356b3c; }
  #Menu-{{ uid }} .MenuItem__Summary {
    display: -webkit-box;
    overflow: hidden;
    margin: 6px 0 0;
    color: var(--text-color-light);
    font-size: 13px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  #Menu-{{ uid }} .MenuItem__Footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
  }
  #Menu-{{ uid }} .MenuItem__Price {
    color: var(--heading-color);
    font-family: var(--heading-font-family);
    font-size: 16px;
    font-weight: 600;
  }
  #Menu-{{ uid }} .MenuItem__Detail {
    color: var(--menu-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  #Menu-{{ uid }} .MenuDialog {
    position: fixed;
    inset: 0;
    z-index: 1001;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(20, 16, 14, .62);
    opacity: 0;
    transition: opacity .2s ease;
  }
  #Menu-{{ uid }} .MenuDialog.is-open { display: flex; opacity: 1; }
  #Menu-{{ uid }} .MenuDialog__Panel {
    position: relative;
    width: min(920px, 100%);
    max-height: min(820px, calc(100vh - 48px));
    overflow-y: auto;
    border-radius: var(--menu-modal-radius);
    background: var(--background);
    box-shadow: 0 28px 80px rgba(0, 0, 0, .24);
  }
  #Menu-{{ uid }} .MenuDialog__Close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--background);
    color: var(--text-color);
    box-shadow: 0 3px 16px rgba(0, 0, 0, .14);
    cursor: pointer;
    font-size: 23px;
    line-height: 1;
  }
  #Menu-{{ uid }} .MenuDialog__Layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr);
  }
  #Menu-{{ uid }} .MenuDialog__Gallery { padding: 20px; }
  #Menu-{{ uid }} .MenuDialog__MainImage {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: max(0px, calc(var(--menu-modal-radius) - 6px));
    background: rgba(var(--text-color-rgb), .055);
  }
  #Menu-{{ uid }} .MenuDialog__Thumbnails {
    display: flex;
    gap: 9px;
    margin-top: 10px;
    overflow-x: auto;
  }
  #Menu-{{ uid }} .MenuDialog__Thumbnail {
    flex: 0 0 66px;
    width: 66px;
    height: 66px;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
  }
  #Menu-{{ uid }} .MenuDialog__Thumbnail[aria-pressed="true"] { border-color: var(--menu-accent); }
  #Menu-{{ uid }} .MenuDialog__Thumbnail img { width: 100%; height: 100%; object-fit: cover; }
  #Menu-{{ uid }} .MenuDialog__Content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 54px 40px 40px 24px;
  }
  #Menu-{{ uid }} .MenuDialog__Title { margin: 0; }
  #Menu-{{ uid }} .MenuDialog__Price {
    margin-top: 10px;
    color: var(--heading-color);
    font-family: var(--heading-font-family);
    font-size: 20px;
    font-weight: 600;
  }
  #Menu-{{ uid }} .MenuDialog__Description { margin-top: 20px; color: var(--text-color-light); }
  #Menu-{{ uid }} .MenuDialog__Options { margin-top: 24px; }
  #Menu-{{ uid }} .MenuDialog__OptionsTitle { margin: 0 0 8px; font-size: 14px; }
  #Menu-{{ uid }} .MenuDialog__Option {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 11px 0;
    border-bottom: 1px solid var(--border-color);
  }
  #Menu-{{ uid }} .MenuDialog__Option:first-of-type { border-top: 1px solid var(--border-color); }
  #Menu-{{ uid }} .MenuDialog__OptionPrice { color: var(--heading-color); font-weight: 600; white-space: nowrap; }
  #Menu-{{ uid }} .MenuSection__Empty { padding: 24px 0; color: var(--text-color-light); }

  /* Desktop split scroll: gallery stays visible while details scroll. */
  @media (min-width: 701px) {
    #Menu-{{ uid }} .MenuDialog__Panel {
      height: min(820px, calc(100vh - 64px));
      max-height: calc(100vh - 64px);
      overflow: hidden;
    }
    #Menu-{{ uid }} .MenuDialog__Layout {
      height: 100%;
      min-height: 0;
    }
    #Menu-{{ uid }} .MenuDialog__Gallery {
      display: flex;
      min-height: 0;
      flex-direction: column;
      overflow: hidden;
    }
    #Menu-{{ uid }} .MenuDialog__MainImage {
      min-height: 0;
      flex: 1 1 auto;
    }
    #Menu-{{ uid }} .MenuDialog__Content {
      min-height: 0;
      justify-content: flex-start;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      border-left: 1px solid var(--border-color);
    }
  }

  @media (max-width: 1000px) {
    #Menu-{{ uid }} .MenuGrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #Menu-{{ uid }} .MenuItem__Button { flex-direction: column; }
    #Menu-{{ uid }} .MenuItem__Media { width: 100%; height: auto; aspect-ratio: 4 / 3; flex-basis: auto; }
  }
  @media (max-width: 700px) {
    #Menu-{{ uid }} { --menu-gap: 14px; }
    #Menu-{{ uid }} .MenuGrid { grid-template-columns: 1fr; }
    #Menu-{{ uid }} .MenuCategory { margin-bottom: 38px; }
    #Menu-{{ uid }} .MenuItem__Button { min-height: 0; flex-direction: row; padding: 11px; }
    #Menu-{{ uid }} .MenuItem__Media { width: 100px; height: 100px; flex: 0 0 100px; aspect-ratio: 1; }
    #Menu-{{ uid }} .MenuItem__Summary { -webkit-line-clamp: 2; }
    #Menu-{{ uid }} .MenuItem__Detail { font-size: 11px; }
    #Menu-{{ uid }} .MenuDialog { align-items: flex-end; padding: 10px; }
    #Menu-{{ uid }} .MenuDialog__Panel { height: auto; max-height: calc(100vh - 20px); overflow-y: auto; border-radius: var(--menu-modal-radius) var(--menu-modal-radius) 0 0; }
    #Menu-{{ uid }} .MenuDialog__Layout { display: block; height: auto; }
    #Menu-{{ uid }} .MenuDialog__Gallery { display: block; overflow: visible; padding: 12px; }
    #Menu-{{ uid }} .MenuDialog__MainImage { aspect-ratio: 4 / 3; }
    #Menu-{{ uid }} .MenuDialog__Content { overflow: visible; padding: 22px 22px 32px; border-left: 0; }
  }
  @media (max-width: 380px) {
    #Menu-{{ uid }} .MenuItem__Media { width: 84px; height: 84px; flex-basis: 84px; }
    #Menu-{{ uid }} .MenuItem__Summary { display: none; }
    #Menu-{{ uid }} .MenuItem__Footer { padding-top: 7px; }
  }
</style>

<section id="Menu-{{ uid }}" class="Section Section--spacingNormal MenuSection" data-section-id="{{ uid }}" data-section-type="menu-list">
  <div class="Container">
    {%- if section.settings.title != blank or section.settings.description != blank or section.settings.subheading != blank -%}
      <header class="MenuSection__Intro MenuSection__Intro--{{ section.settings.heading_alignment }}">
        {%- if section.settings.subheading != blank -%}<p class="Heading u-h6 Text--subdued">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="MenuSection__Title Heading u-h1">{{ section.settings.title | escape }}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<div class="MenuSection__Description Rte">{{ section.settings.description }}</div>{%- endif -%}
      </header>
    {%- endif -%}
  </div>

  {%- if section.settings.show_filter -%}
    <nav class="MenuFilter" data-menu-filter aria-label="Categorías del menú">
      <div class="Container">
        <div class="MenuFilter__Track">
          {%- for block in section.blocks -%}
            {%- if block.type == 'category' and block.settings.title != blank -%}
              <button type="button" class="MenuFilter__Item{% unless has_named_category %} is-active{% endunless %}" data-filter-target="MenuCategory-{{ uid }}-{{ block.id }}">
                {{ block.settings.title | escape }}
              </button>
              {%- assign has_named_category = true -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </nav>
  {%- endif -%}

  <div class="Container">
    {%- if section.blocks.size == 0 -%}
      {%- if request.design_mode -%}<p class="MenuSection__Empty">Agrega bloques de categoría e ítem para construir la carta.</p>{%- endif -%}
    {%- else -%}
      {%- assign category_open = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- assign category_additions = block.settings -%}
          {%- if category_open -%}</div></div>{%- endif -%}
          {%- assign category_open = true -%}
          <div class="MenuCategory" id="MenuCategory-{{ uid }}-{{ block.id }}" data-menu-category {{ block.shopify_attributes }}>
            <header class="MenuCategory__Header">
              <h3 class="MenuCategory__Title Heading u-h2">{{ block.settings.title | default: section.settings.general_category_label | escape }}</h3>
              {%- if block.settings.description != blank -%}<p class="MenuCategory__Description">{{ block.settings.description | escape }}</p>{%- endif -%}
            </header>
            <div class="MenuGrid">
        {%- elsif block.type == 'item' and block.settings.title != blank -%}
          {%- unless category_open -%}
            {%- assign category_open = true -%}
            <div class="MenuCategory" id="MenuCategory-{{ uid }}-general" data-menu-category>
              <header class="MenuCategory__Header"><h3 class="MenuCategory__Title Heading u-h2">{{ section.settings.general_category_label | escape }}</h3></header>
              <div class="MenuGrid">
          {%- endunless -%}
          {%- assign has_options = false -%}
          {%- if block.settings.option_1_name != blank or block.settings.option_2_name != blank or block.settings.option_3_name != blank or block.settings.option_4_name != blank -%}
            {%- assign has_options = true -%}
          {%- endif -%}
          {%- assign has_dietary = false -%}
          {%- if block.settings.contains_peanuts or block.settings.contains_tree_nuts or block.settings.contains_gluten or block.settings.contains_dairy or block.settings.is_spicy or block.settings.is_vegetarian or block.settings.is_vegan -%}{%- assign has_dietary = true -%}{%- endif -%}
          {%- assign additions_source = category_additions -%}
          {%- assign additions_prefix = '' -%}
          {%- if block.settings.additions_behavior == 'custom' -%}
            {%- assign additions_source = block.settings -%}
            {%- assign additions_prefix = 'custom_' -%}
          {%- elsif block.settings.additions_behavior == 'none' -%}
            {%- assign additions_source = nil -%}
          {%- endif -%}
          {%- assign additions_title_key = additions_prefix | append: 'additions_title' -%}
          {%- assign additions_help_key = additions_prefix | append: 'additions_help' -%}
          {%- assign additions_min_key = additions_prefix | append: 'additions_min' -%}
          {%- assign additions_max_key = additions_prefix | append: 'additions_max' -%}
          {%- assign secondary_additions_source = category_additions -%}
          {%- assign secondary_additions_prefix = 'secondary_' -%}
          {%- if block.settings.secondary_additions_behavior == 'custom' -%}
            {%- assign secondary_additions_source = block.settings -%}
            {%- assign secondary_additions_prefix = 'custom_secondary_' -%}
          {%- elsif block.settings.secondary_additions_behavior == 'none' -%}
            {%- assign secondary_additions_source = nil -%}
          {%- endif -%}
          {%- assign secondary_title_key = secondary_additions_prefix | append: 'additions_title' -%}
          {%- assign secondary_help_key = secondary_additions_prefix | append: 'additions_help' -%}
          {%- assign secondary_min_key = secondary_additions_prefix | append: 'additions_min' -%}
          {%- assign secondary_max_key = secondary_additions_prefix | append: 'additions_max' -%}
          <article class="MenuItem" data-menu-item {{ block.shopify_attributes }}>
            <button type="button" class="MenuItem__Button" data-menu-open="MenuDialog-{{ uid }}-{{ block.id }}" aria-haspopup="dialog" aria-controls="MenuDialog-{{ uid }}-{{ block.id }}">
              <span class="MenuItem__Media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 320 }}" srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ block.settings.image | image_url: width: 320 }} 320w, {{ block.settings.image | image_url: width: 480 }} 480w" sizes="{{ section.settings.image_size }}px" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}">
                {%- else -%}
                  <span class="MenuItem__Placeholder" aria-hidden="true">DA</span>
                {%- endif -%}
              </span>
              <span class="MenuItem__Content">
                {%- if block.settings.badge != blank -%}<span class="MenuItem__Badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                <span class="MenuItem__Name">{{ block.settings.title | escape }}</span>
                {%- if has_dietary -%}<span class="MenuDietary MenuDietary--card" data-menu-dietary-card>{% render 'menu-dietary-indicators', item: block.settings, compact: true %}</span>{%- endif -%}
                {%- if block.settings.short_description != blank -%}<span class="MenuItem__Summary">{{ block.settings.short_description | escape }}</span>{%- endif -%}
                <span class="MenuItem__Footer">
                  {%- if block.settings.base_price != blank -%}<span class="MenuItem__Price">{% if has_options and section.settings.from_label != blank %}{{ section.settings.from_label | escape }} {% endif %}{{ block.settings.base_price | escape }}</span>{%- endif -%}
                  <span class="MenuItem__Detail">{{ section.settings.detail_button_label | escape }}</span>
                </span>
              </span>
            </button>
          </article>

          <div id="MenuDialog-{{ uid }}-{{ block.id }}" class="MenuDialog" data-menu-dialog role="dialog" aria-modal="true" aria-labelledby="MenuDialogTitle-{{ uid }}-{{ block.id }}" aria-hidden="true">
            <div class="MenuDialog__Panel" data-menu-panel>
              <button type="button" class="MenuDialog__Close" data-menu-close aria-label="Cerrar detalles">×</button>
              <div class="MenuDialog__Layout">
                <div class="MenuDialog__Gallery">
                  <div class="MenuDialog__MainImage">
                    {%- if block.settings.image != blank -%}
                      <img data-menu-main-image src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w" sizes="(max-width: 700px) 100vw, 50vw" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}">
                    {%- else -%}
                      <span class="MenuItem__Placeholder" aria-hidden="true">Dulce Avellana</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.image != blank or block.settings.gallery_image_1 != blank or block.settings.gallery_image_2 != blank or block.settings.gallery_image_3 != blank -%}
                    <div class="MenuDialog__Thumbnails" aria-label="Galería de {{ block.settings.title | escape }}">
                      {%- if block.settings.image != blank -%}
                        <button type="button" class="MenuDialog__Thumbnail" data-menu-thumbnail data-image-src="{{ block.settings.image | image_url: width: 900 }}" data-image-srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w" data-image-alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" aria-pressed="true"><img src="{{ block.settings.image | image_url: width: 140 }}" width="70" height="70" loading="lazy" alt=""></button>
                      {%- endif -%}
                      {%- for index in (1..3) -%}
                        {%- assign gallery_key = 'gallery_image_' | append: index -%}
                        {%- assign gallery_image = block.settings[gallery_key] -%}
                        {%- if gallery_image != blank -%}
                          <button type="button" class="MenuDialog__Thumbnail" data-menu-thumbnail data-image-src="{{ gallery_image | image_url: width: 900 }}" data-image-srcset="{{ gallery_image | image_url: width: 500 }} 500w, {{ gallery_image | image_url: width: 900 }} 900w" data-image-alt="{{ gallery_image.alt | default: block.settings.title | escape }}" aria-pressed="false"><img src="{{ gallery_image | image_url: width: 140 }}" width="70" height="70" loading="lazy" alt=""></button>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
                <div class="MenuDialog__Content">
                  {%- if block.settings.badge != blank -%}<span class="MenuDialog__Badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
                  <h3 id="MenuDialogTitle-{{ uid }}-{{ block.id }}" class="MenuDialog__Title Heading u-h2">{{ block.settings.title | escape }}</h3>
                  {%- if has_dietary -%}<div class="MenuDietary MenuDietary--modal" data-menu-dietary-modal>{% render 'menu-dietary-indicators', item: block.settings, compact: false %}</div>{%- endif -%}
                  {%- if block.settings.base_price != blank -%}<div class="MenuDialog__Price">{% if has_options and section.settings.from_label != blank %}{{ section.settings.from_label | escape }} {% endif %}{{ block.settings.base_price | escape }}</div>{%- endif -%}
                  {%- if block.settings.description != blank -%}<div class="MenuDialog__Description Rte">{{ block.settings.description }}</div>{%- elsif block.settings.short_description != blank -%}<p class="MenuDialog__Description">{{ block.settings.short_description | escape }}</p>{%- endif -%}
                  {%- if has_options -%}
                    <fieldset class="MenuDialog__Options">
                      <legend class="MenuDialog__OptionsTitle Heading">Tamaños y presentaciones</legend>
                      {%- assign presentation_selected = false -%}
                      {%- for index in (1..4) -%}
                        {%- assign name_key = 'option_' | append: index | append: '_name' -%}
                        {%- assign price_key = 'option_' | append: index | append: '_price' -%}
                        {%- assign option_name = block.settings[name_key] -%}
                        {%- assign option_price = block.settings[price_key] -%}
                        {%- if option_name != blank -%}
                          <label class="MenuDialog__Option"><span><input type="radio" name="presentation-{{ uid }}-{{ block.id }}" data-menu-presentation data-price="{{ option_price | default: 0 }}" {% unless presentation_selected %}checked{% endunless %}> {{ option_name | escape }}</span><span class="MenuDialog__OptionPrice" data-format-price="{{ option_price | default: 0 }}"></span></label>
                          {%- assign presentation_selected = true -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </fieldset>
                  {%- endif -%}
                  {%- if additions_source != nil -%}
                    <fieldset class="MenuDialog__Options" data-menu-additions data-additions-group="primary" data-min="{{ additions_source[additions_min_key] | default: 0 }}" data-max="{{ additions_source[additions_max_key] | default: 1 }}">
                      <legend class="MenuDialog__OptionsTitle Heading">{{ additions_source[additions_title_key] | default: 'Personaliza tu plato' | escape }}</legend>
                      {%- if additions_source[additions_help_key] != blank -%}<p>{{ additions_source[additions_help_key] | escape }}</p>{%- endif -%}
                      {%- for index in (1..8) -%}
                        {%- assign addition_name_key = additions_prefix | append: 'addition_' | append: index | append: '_name' -%}
                        {%- assign addition_price_key = additions_prefix | append: 'addition_' | append: index | append: '_price' -%}
                        {%- assign addition_name = additions_source[addition_name_key] -%}
                        {%- assign addition_price = additions_source[addition_price_key] | default: 0 -%}
                        {%- if addition_name != blank -%}<label class="MenuDialog__Option"><span><input type="checkbox" data-menu-addition data-price="{{ addition_price }}"> {{ addition_name | escape }}</span><span class="MenuDialog__OptionPrice" data-format-price="{{ addition_price }}" data-addition-price></span></label>{%- endif -%}
                      {%- endfor -%}
                      <p data-menu-selection-status aria-live="polite"></p>
                    </fieldset>
                  {%- endif -%}
                  {%- if secondary_additions_source != nil -%}
                    {%- assign secondary_has_options = false -%}
                    {%- for index in (1..8) -%}{%- assign key = secondary_additions_prefix | append: 'addition_' | append: index | append: '_name' -%}{%- if secondary_additions_source[key] != blank -%}{%- assign secondary_has_options = true -%}{%- endif -%}{%- endfor -%}
                    {%- if secondary_has_options -%}
                      <fieldset class="MenuDialog__Options" data-menu-additions data-additions-group="secondary" data-min="{{ secondary_additions_source[secondary_min_key] | default: 0 }}" data-max="{{ secondary_additions_source[secondary_max_key] | default: 3 }}">
                        <legend class="MenuDialog__OptionsTitle Heading">{{ secondary_additions_source[secondary_title_key] | default: 'Adiciones especiales' | escape }}</legend>
                        {%- if secondary_additions_source[secondary_help_key] != blank -%}<p>{{ secondary_additions_source[secondary_help_key] | escape }}</p>{%- endif -%}
                        {%- for index in (1..8) -%}
                          {%- assign name_key = secondary_additions_prefix | append: 'addition_' | append: index | append: '_name' -%}
                          {%- assign price_key = secondary_additions_prefix | append: 'addition_' | append: index | append: '_price' -%}
                          {%- assign addition_name = secondary_additions_source[name_key] -%}
                          {%- assign addition_price = secondary_additions_source[price_key] | default: 0 -%}
                          {%- if addition_name != blank -%}<label class="MenuDialog__Option"><span><input type="checkbox" data-menu-addition data-price="{{ addition_price }}"> {{ addition_name | escape }}</span><span class="MenuDialog__OptionPrice" data-format-price="{{ addition_price }}" data-addition-price></span></label>{%- endif -%}
                        {%- endfor -%}
                        <p data-menu-selection-status aria-live="polite"></p>
                      </fieldset>
                    {%- endif -%}
                  {%- endif -%}
                  <div class="MenuDialog__Price" data-menu-total data-base-price="{{ block.settings.base_price | default: 0 }}" aria-live="polite"></div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if category_open -%}</div></div>{%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function initMenu(root) {
      if (!root || root.dataset.menuInitialized === 'true') return;
      root.dataset.menuInitialized = 'true';
      var activeTrigger = null;

      function focusable(dialog) {
        return Array.prototype.slice.call(dialog.querySelectorAll('button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])'));
      }
      function openDialog(dialog, trigger) {
        if (!dialog) return;
        activeTrigger = trigger;
        dialog.classList.add('is-open');
        dialog.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('MenuModalOpen');
        var close = dialog.querySelector('[data-menu-close]');
        updateEstimate(dialog);
        if (close) close.focus();
      }
      function formatMoney(value) {
        return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(Number(value) || 0);
      }
      function normalizeLimits(group) {
        var count = group.querySelectorAll('[data-menu-addition]').length;
        var max = Math.min(Math.max(Number(group.dataset.max) || 1, 1), count || 1);
        var min = Math.min(Math.max(Number(group.dataset.min) || 0, 0), max);
        return { min: min, max: max };
      }
      function getBasePrice(dialog) {
        var selected = dialog.querySelector('[data-menu-presentation]:checked');
        var totalNode = dialog.querySelector('[data-menu-total]');
        return selected ? Number(selected.dataset.price) || 0 : Number(totalNode && totalNode.dataset.basePrice) || 0;
      }
      function updateEstimate(dialog) {
        if (!dialog) return;
        dialog.querySelectorAll('[data-format-price]').forEach(function (el) {
          var value = Number(el.dataset.formatPrice) || 0;
          el.textContent = el.hasAttribute('data-addition-price') ? (value ? '+ ' + formatMoney(value) : 'Sin costo') : formatMoney(value);
        });
        var totalNode = dialog.querySelector('[data-menu-total]');
        var total = getBasePrice(dialog);
        var groups = dialog.querySelectorAll('[data-menu-additions]');
        groups.forEach(function (group) {
          var limits = normalizeLimits(group);
          var additions = Array.prototype.slice.call(group.querySelectorAll('[data-menu-addition]'));
          var selected = additions.filter(function (input) { return input.checked; });
          selected.forEach(function (input) { total += Number(input.dataset.price) || 0; });
          additions.forEach(function (input) { input.disabled = !input.checked && selected.length >= limits.max; });
          var status = group.querySelector('[data-menu-selection-status]');
          if (status) status.textContent = selected.length < limits.min ? 'Selecciona al menos ' + limits.min : selected.length + ' de ' + limits.max + ' seleccionadas';
        });
        if (totalNode) totalNode.textContent = 'Total estimado: ' + formatMoney(total);
      }
      function resetConfigurator(dialog) {
        var radios = dialog.querySelectorAll('[data-menu-presentation]');
        radios.forEach(function (radio, index) { radio.checked = index === 0; });
        dialog.querySelectorAll('[data-menu-addition]').forEach(function (input) { input.checked = false; input.disabled = false; });
        updateEstimate(dialog);
      }
      function closeDialog(dialog) {
        if (!dialog) return;
        dialog.classList.remove('is-open');
        dialog.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('MenuModalOpen');
        resetConfigurator(dialog);
        if (activeTrigger && document.documentElement.contains(activeTrigger)) activeTrigger.focus();
        activeTrigger = null;
      }
      function selectImage(button) {
        var dialog = button.closest('[data-menu-dialog]');
        var image = dialog && dialog.querySelector('[data-menu-main-image]');
        if (!image) return;
        image.src = button.dataset.imageSrc;
        image.srcset = button.dataset.imageSrcset || '';
        image.alt = button.dataset.imageAlt || '';
        dialog.querySelectorAll('[data-menu-thumbnail]').forEach(function (thumbnail) {
          thumbnail.setAttribute('aria-pressed', thumbnail === button ? 'true' : 'false');
        });
      }
      function scrollToCategory(button) {
        var target = document.getElementById(button.dataset.filterTarget);
        if (!target) return;
        root.querySelectorAll('.MenuFilter__Item').forEach(function (item) { item.classList.remove('is-active'); });
        button.classList.add('is-active');
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      root.addEventListener('click', function (event) {
        var opener = event.target.closest('[data-menu-open]');
        var closer = event.target.closest('[data-menu-close]');
        var thumbnail = event.target.closest('[data-menu-thumbnail]');
        var filter = event.target.closest('[data-filter-target]');
        var backdrop = event.target.matches('[data-menu-dialog]') ? event.target : null;
        if (opener) openDialog(document.getElementById(opener.dataset.menuOpen), opener);
        else if (closer) closeDialog(closer.closest('[data-menu-dialog]'));
        else if (thumbnail) selectImage(thumbnail);
        else if (filter) scrollToCategory(filter);
        else if (backdrop) closeDialog(backdrop);
      });

      root.addEventListener('keydown', function (event) {
        var dialog = event.target.closest('[data-menu-dialog].is-open');
        if (!dialog) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeDialog(dialog);
          return;
        }
        if (event.key !== 'Tab') return;
        var items = focusable(dialog);
        if (!items.length) return;
        var first = items[0];
        var last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      });
      root.addEventListener('change', function (event) {
        if (event.target.matches('[data-menu-presentation], [data-menu-addition]')) updateEstimate(event.target.closest('[data-menu-dialog]'));
      });
    }

    initMenu(document.getElementById('Menu-{{ uid }}'));
    document.addEventListener('shopify:section:load', function (event) {
      initMenu(event.target.querySelector('[data-section-type="menu-list"]'));
    });
    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target.querySelector('[data-menu-dialog].is-open')) document.documentElement.classList.remove('MenuModalOpen');
    });
  })();
</script>

